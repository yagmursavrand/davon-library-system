        {
            "type": "java",
        "name": "Debug Library Backend (Quarkus)",
            "request": "launch",
            "mainClass": "com.davon.library.App",
        "projectName": "library-backend",
        "vmArgs": [
          "-Dquarkus.http.port=8080",
          "-Dquarkus.datasource.db-kind=h2",
          "-Dquarkus.datasource.jdbc.url=jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1",
          "-Dquarkus.hibernate-orm.database.generation=drop-and-create"
        ],
        "env": {
          "QUARKUS_PROFILE": "dev"
        },
        "console": "internalConsole",
        "stopOnEntry": false
        },
        {
            "type": "java",
        "name": "Debug Any Class",
            "request": "launch",
        "mainClass": "${input:mainClass}",
        "projectName": "library-backend",
        "console": "internalConsole",
        "stopOnEntry": false
      },
      {
        "type": "java",
        "name": "Attach to Quarkus (Dev Mode)",
        "request": "attach",
        "hostName": "localhost",
        "port": 5005,
        "projectName": "library-backend"
      },
      {
        "type": "java",
        "name": "Attach to Quarkus (Test Mode)",
        "request": "attach",
        "hostName": "localhost",
        "port": 5006,
            "projectName": "library-backend"
      },
      {
        "type": "java",
        "name": "Debug SimpleFineCalculationDebugTest (JUnit)",
        "request": "launch",
        "mainClass": "org.junit.platform.console.ConsoleLauncher",
        "args": [
          "--class-path",
          "${workspaceFolder}/library-backend/target/test-classes",
          "--select-class",
          "com.davon.library.debug.SimpleFineCalculationDebugTest"
        ],
        "projectName": "library-backend",
        "console": "internalConsole",
        "stopOnEntry": false
      },
                  {
                "type": "java",
